{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "data",
  "id": "inkstone-theme",
  "publisher": "wahaha1024",
  "name": "Inkstone for Orca",
  "version": "0.5.0",
  "description": "墨观 Inkstone — six Chinese-colour themes (three light, three dark) for the Orca interface, each with a matching terminal palette.",
  "author": {
    "name": "wahaha1024",
    "url": "https://github.com/wahaha1024"
  },
  "repository": "https://github.com/wahaha1024/inkstone-orca",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "inkstone-xuanmo",
        "title": "Inkstone Xuanmo",
        "path": "themes/inkstone-xuanmo.json"
      },
      {
        "id": "inkstone-xuanmo-dimmed",
        "title": "Inkstone Xuanmo Dimmed",
        "path": "themes/inkstone-xuanmo-dimmed.json"
      },
      {
        "id": "inkstone-xuanzhi",
        "title": "Inkstone Xuanzhi",
        "path": "themes/inkstone-xuanzhi.json"
      },
      {
        "id": "inkstone-xuanzhi-dimmed",
        "title": "Inkstone Xuanzhi Dimmed",
        "path": "themes/inkstone-xuanzhi-dimmed.json"
      },
      {
        "id": "inkstone-canghai",
        "title": "Inkstone Canghai",
        "path": "themes/inkstone-canghai.json"
      },
      {
        "id": "inkstone-qingci",
        "title": "Inkstone Qingci",
        "path": "themes/inkstone-qingci.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "inkstone-xuanmo",
        "title": "Inkstone Xuanmo",
        "path": "terminal/inkstone-xuanmo.json"
      },
      {
        "id": "inkstone-xuanmo-dimmed",
        "title": "Inkstone Xuanmo Dimmed",
        "path": "terminal/inkstone-xuanmo-dimmed.json"
      },
      {
        "id": "inkstone-xuanzhi",
        "title": "Inkstone Xuanzhi",
        "path": "terminal/inkstone-xuanzhi.json"
      },
      {
        "id": "inkstone-xuanzhi-dimmed",
        "title": "Inkstone Xuanzhi Dimmed",
        "path": "terminal/inkstone-xuanzhi-dimmed.json"
      },
      {
        "id": "inkstone-canghai",
        "title": "Inkstone Canghai",
        "path": "terminal/inkstone-canghai.json"
      },
      {
        "id": "inkstone-qingci",
        "title": "Inkstone Qingci",
        "path": "terminal/inkstone-qingci.json"
      }
    ]
  },
  "capabilities": []
}
