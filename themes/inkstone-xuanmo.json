{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#14131a",
    "--editor-surface": "#14131a",
    "--foreground": "#d4cec4",
    "--card": "#1a1922",
    "--card-foreground": "#d4cec4",
    "--popover": "#2b2a36",
    "--popover-foreground": "#d4cec4",
    "--primary": "#619ac3",
    "--primary-foreground": "#14131a",
    "--secondary": "#22212c",
    "--secondary-foreground": "#d4cec4",
    "--muted": "#0f0e14",
    "--muted-foreground": "#8b8597",
    "--accent": "#24222e",
    "--accent-foreground": "#d4cec4",
    "--border": "#343240",
    "--input": "#343240",
    "--ring": "#619ac3",
    "--chart-1": "#619ac3",
    "--chart-2": "#2bae85",
    "--chart-3": "#d6a01d",
    "--chart-4": "#d8574a",
    "--chart-5": "#c08eaf",
    "--sidebar": "#1a1922",
    "--sidebar-foreground": "#ada599",
    "--sidebar-primary": "#619ac3",
    "--sidebar-primary-foreground": "#14131a",
    "--sidebar-accent": "#302e3c",
    "--sidebar-accent-foreground": "#d4cec4",
    "--sidebar-border": "#343240",
    "--sidebar-ring": "#619ac3",
    "--worktree-sidebar": "#0f0e14",
    "--worktree-sidebar-foreground": "#d4cec4",
    "--worktree-sidebar-accent": "#302e3c",
    "--worktree-sidebar-accent-foreground": "#d4cec4",
    "--worktree-sidebar-border": "#343240",
    "--worktree-sidebar-ring": "#619ac3",
    "--worktree-sidebar-active-border": "#4a4557",
    "--tab-bar": "#1a1922",
    "--tab-active": "#14131a",
    "--tab-active-foreground": "#d4cec4",
    "--tab-active-indicator": "#619ac3",
    "--tab-inactive": "#1a1922",
    "--tab-inactive-foreground": "#ada599",
    "--split-divider": "#262430",
    "--split-divider-hover": "#4a4557",
    "--text-link": "#619ac3",
    "--diff-added": "#2bae85",
    "--diff-removed": "#d8574a",
    "--git-decoration-added": "#2bae85",
    "--git-decoration-modified": "#d6a01d",
    "--git-decoration-deleted": "#d8574a",
    "--git-decoration-renamed": "#619ac3",
    "--git-decoration-untracked": "#57c3c2",
    "--git-decoration-copied": "#8b8597",
    "--git-decoration-ignored": "#8b8597"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.word",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#d8574a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "support.function.builtin",
        "variable.function",
        "meta.function-call",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#619ac3"
      }
    },
    {
      "scope": [
        "meta.method-call",
        "entity.name.function.method",
        "support.function.method"
      ],
      "settings": {
        "foreground": "#8fb2c9"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.other.namespace",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.trait",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#c08eaf"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "string.other.link",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#2bae85"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "constant.other.symbol",
        "support.constant",
        "support.variable",
        "variable.other.constant",
        "variable.other.enummember",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.graphql",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d4cec4"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "variable.parameter.url",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#c08eaf"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.objectliteral.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#c9c3b9"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#e45f6f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "entity.name.function.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#c08eaf"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "punctuation.definition.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#57c3c2"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.character.escape.cs",
        "string.quoted.double.escape"
      ],
      "settings": {
        "foreground": "#57c3c2"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.comparison",
        "keyword.operator.ternary",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#9a94a4"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#8f899e"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e25737"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8a8175"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#d8574a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#c08eaf",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#2bae85",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#619ac3",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "markup.list",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#d8574a"
      }
    },
    {
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#2bae85"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#d8574a"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "meta.diff.header",
        "punctuation.definition.metadata"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#c08eaf"
      }
    },
    {
      "scope": [
        "keyword.other.unit.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell"
      ],
      "settings": {
        "foreground": "#c08eaf"
      }
    },
    {
      "scope": [
        "keyword.other.sql",
        "keyword.sql"
      ],
      "settings": {
        "foreground": "#d8574a"
      }
    },
    {
      "scope": [
        "punctuation.support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8f899e"
      }
    }
  ]
}
