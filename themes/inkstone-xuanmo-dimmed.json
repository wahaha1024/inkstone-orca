{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#19181e",
    "--editor-surface": "#19181e",
    "--foreground": "#d8d2c6",
    "--card": "#1e1d24",
    "--card-foreground": "#d8d2c6",
    "--popover": "#2b2933",
    "--popover-foreground": "#d8d2c6",
    "--primary": "#66a9c9",
    "--primary-foreground": "#19181e",
    "--secondary": "#24222b",
    "--secondary-foreground": "#d8d2c6",
    "--muted": "#151419",
    "--muted-foreground": "#8f8996",
    "--accent": "#232129",
    "--accent-foreground": "#d8d2c6",
    "--border": "#393643",
    "--input": "#393643",
    "--ring": "#66a9c9",
    "--chart-1": "#66a9c9",
    "--chart-2": "#69a794",
    "--chart-3": "#b78b26",
    "--chart-4": "#c57f73",
    "--chart-5": "#d6a01d",
    "--sidebar": "#1e1d24",
    "--sidebar-foreground": "#b0a99f",
    "--sidebar-primary": "#66a9c9",
    "--sidebar-primary-foreground": "#19181e",
    "--sidebar-accent": "#2e2c36",
    "--sidebar-accent-foreground": "#d8d2c6",
    "--sidebar-border": "#393643",
    "--sidebar-ring": "#66a9c9",
    "--worktree-sidebar": "#151419",
    "--worktree-sidebar-foreground": "#d8d2c6",
    "--worktree-sidebar-accent": "#2e2c36",
    "--worktree-sidebar-accent-foreground": "#d8d2c6",
    "--worktree-sidebar-border": "#393643",
    "--worktree-sidebar-ring": "#66a9c9",
    "--worktree-sidebar-active-border": "#4f4a5b",
    "--tab-bar": "#1e1d24",
    "--tab-active": "#19181e",
    "--tab-active-foreground": "#d8d2c6",
    "--tab-active-indicator": "#66a9c9",
    "--tab-inactive": "#1e1d24",
    "--tab-inactive-foreground": "#b0a99f",
    "--split-divider": "#2a2832",
    "--split-divider-hover": "#4f4a5b",
    "--text-link": "#66a9c9",
    "--diff-added": "#69a794",
    "--diff-removed": "#c57f73",
    "--git-decoration-added": "#69a794",
    "--git-decoration-modified": "#d6a01d",
    "--git-decoration-deleted": "#c57f73",
    "--git-decoration-renamed": "#66a9c9",
    "--git-decoration-untracked": "#0eb0c9",
    "--git-decoration-copied": "#8f8996",
    "--git-decoration-ignored": "#8f8996"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.word",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#c57f73"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "support.function.builtin",
        "variable.function",
        "meta.function-call",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#66a9c9"
      }
    },
    {
      "scope": [
        "meta.method-call",
        "entity.name.function.method",
        "support.function.method"
      ],
      "settings": {
        "foreground": "#619ac3"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.other.namespace",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.trait",
        "entity.name.type.enum",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "string.other.link",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#69a794"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "constant.other.symbol",
        "support.constant",
        "support.variable",
        "variable.other.constant",
        "variable.other.enummember",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#b78b26"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.graphql",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d8d2c6"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "variable.parameter.url",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#bc84a8"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.objectliteral.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#c5bfb4"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#de7897"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "entity.name.function.macro",
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#c08eaf"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "punctuation.definition.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#0eb0c9"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.character.escape.cs",
        "string.quoted.double.escape"
      ],
      "settings": {
        "foreground": "#0eb0c9"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.comparison",
        "keyword.operator.ternary",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#9d97a8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#837d90"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e25737"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#7a7480"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#c57f73",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d6a01d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#69a794",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#66a9c9",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "markup.list",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#c57f73"
      }
    },
    {
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#69a794"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#c57f73"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "meta.diff.header",
        "punctuation.definition.metadata"
      ],
      "settings": {
        "foreground": "#85809e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#d6a01d"
      }
    },
    {
      "scope": [
        "keyword.other.unit.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#b78b26"
      }
    },
    {
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell"
      ],
      "settings": {
        "foreground": "#bc84a8"
      }
    },
    {
      "scope": [
        "keyword.other.sql",
        "keyword.sql"
      ],
      "settings": {
        "foreground": "#c57f73"
      }
    },
    {
      "scope": [
        "punctuation.support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#837d90"
      }
    }
  ]
}
